{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mill-it Ops",
  "version": "0.1.0",
  "identifier": "com.sarthak.mill-it-tauri-ai",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mill-it Ops",
        "width": 1120,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
  "active": true,
  "targets": "all",
  "icon": [
    "icons/32x32.png",
    "icons/128x128.png",
    "icons/128x128@2x.png",
    "icons/icon.icns",
    "icons/icon.ico"
  ],
  "macOS": {
    "signingIdentity": "-",
    "minimumSystemVersion": "12.0"
  }
}
}
