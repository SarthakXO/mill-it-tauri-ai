      "columns": [
        {
          "name": "id",
          "type": "text",
          "primary_key": true,
          "sensitivity": "internal"
        },
        {
          "name": "order_id",
          "type": "text",
          "nullable": true,
          "references": "order.id",
          "sensitivity": "internal"
        },
        {
          "name": "amount",
          "type": "integer",
          "sensitivity": "safe"
        },
        {
          "name": "currency_code",
          "type": "text",
          "sensitivity": "safe"
        },
        {
          "name": "status",
          "type": "text",
          "nullable": true,
          "sensitivity": "safe"
        },
        {
          "name": "canceled_at",
          "type": "timestamptz",
          "nullable": true,
          "sensitivity": "safe"
        },
        {
          "name": "created_at",
          "type": "timestamptz",
          "sensitivity": "safe"
        },
        {
          "name": "updated_at",
          "type": "timestamptz",
          "sensitivity": "safe"
        }
      ]
    },
    {
